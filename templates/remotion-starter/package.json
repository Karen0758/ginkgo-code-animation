{
  "name": "ginkgo-code-animation-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts GinkgoStarter out/film.mp4 --codec h264 --crf 20 --concurrency=2 --chrome-mode=chrome-for-testing",
    "still": "remotion still src/index.ts GinkgoStarter out/poster.jpg --frame=300 --chrome-mode=chrome-for-testing"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  }
}
